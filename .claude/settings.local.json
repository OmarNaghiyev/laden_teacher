{
  "permissions": {
    "allow": [
      "PowerShell(node -v)",
      "PowerShell(npm -v)",
      "PowerShell(npm install --no-audit --no-fund 2>&1)",
      "PowerShell(npm install next@latest --no-audit --no-fund 2>&1 | Select-Object -Last 8; \\(Get-Content package.json | Select-String '\"next\"'\\))",
      "PowerShell(npm install react@^19 react-dom@^19 --no-audit --no-fund 2>&1)",
      "PowerShell(npm ls next react react-dom --depth=0 2>&1)",
      "PowerShell(npx tsc --noEmit 2>&1)",
      "PowerShell($env:SUPABASE_URL=\"\"; npm run build 2>&1 | Select-Object -Last 45)",
      "PowerShell(npm run build 2>&1)",
      "Bash(node mock-supabase.mjs)",
      "Bash(powershell -c \"\\(Get-NetTCPConnection -LocalPort 54321 -State Listen\\).OwningProcess\")",
      "Bash(taskkill //F //FI \"PID eq $\\(powershell -c \"\\(Get-NetTCPConnection -LocalPort 54321 -State Listen\\).OwningProcess\" 2>/dev/null\\)\")"
    ]
  }
}
