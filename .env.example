# ---- Supabase ----
# Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Optional but recommended: service_role key (Project Settings -> API -> service_role).
# If set, it is used for all server-side DB access instead of the anon key.
# NEVER prefix it with NEXT_PUBLIC_ — it must stay server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Telegram ----
# Create a bot via @BotFather -> token
TELEGRAM_BOT_TOKEN=123456789:AAAA-BBBB...
# Your own chat id (write to the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy result[0].message.chat.id)
TELEGRAM_CHAT_ID=123456789

# ---- Admin panel ----
# Password for /admin. Use a long random string.
ADMIN_PASSWORD=change-me-to-a-long-random-string
